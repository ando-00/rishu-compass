#!/bin/sh
# 履歴を書き換えないので、鍵は一度入れると消せない。コミットの前に止める。

if git diff --cached --name-only | grep -E '(^|/)\.dev\.vars$' >/dev/null; then
  echo "pre-commit: .dev.vars はコミットできません" >&2
  exit 1
fi

if git diff --cached --no-color --no-ext-diff | grep -E '^\+.*sk-ant-[A-Za-z0-9_-]{20,}' >/dev/null; then
  echo "pre-commit: API キーらしい文字列があるため、コミットを止めました" >&2
  exit 1
fi

# コードを含むコミットは、コミットされる中身で build と test を回す（H21）
node "$(dirname "$0")/staged-check.mjs" || exit 1
